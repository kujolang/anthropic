from anthropic import messages

result := messages({"model": env("ANTHROPIC_MODEL"), "max_tokens": 128, "messages": [{"role": "user", "content": [{"type": "image", "source": {"type": "base64", "media_type": "image/png", "data": env("ANTHROPIC_IMAGE_BASE64")}}, {"type": "text", "text": "Describe this image."}]}]})
print(result["data"]["content"])
